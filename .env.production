# Production build settings. Committed on purpose — see .gitignore.
#
# Vite reads this for any `vite build`, on any machine or host, so the deployed
# app cannot lose its configuration because a dashboard setting was missed.
# Only VITE_-prefixed values reach the browser, and all three below are meant to.
#
# VITE_READONLY=1 makes writing impossible, not merely hidden: supabase.ts
# refuses insert/update/upsert/delete/rpc, and the write UI is not rendered.
# The club's fifteen years of history live in this project and there is no
# backup on our side, so nothing reachable from the internet may write to it.
# Turning this off is a decision to point the app at a database it is allowed
# to damage — do that only against a non-production project.
VITE_SUPABASE_URL=https://urlabzyihqrsdeasvrfe.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVybGFienlpaHFyc2RlYXN2cmZlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDUxNTI0MzUsImV4cCI6MjA2MDcyODQzNX0.mWtHI4LIagdrm3jYonkbudro6M1M4WEXmFQdpOFpu5g
VITE_READONLY=1
